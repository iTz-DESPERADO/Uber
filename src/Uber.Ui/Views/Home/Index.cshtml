@{
    ViewData["Title"] = "Ride";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="booking-page">
    <div class="booking-intro">
        <span class="booking-eyebrow">Uber rides</span>
        <h1>Go anywhere with Uber.</h1>
        <p>Choose your pickup and destination, compare the trip estimate, and request your ride in a few simple steps.</p>
        <div class="booking-benefits" aria-label="Ride benefits">
            <span><i class="fa-solid fa-shield-halved"></i> Safer trips</span>
            <span><i class="fa-solid fa-location-dot"></i> Live locations</span>
            <span><i class="fa-solid fa-receipt"></i> Clear pricing</span>
        </div>
    </div>

    <div class="booking-grid">
        <section class="booking-card" aria-labelledby="booking-title">
            <div class="booking-card__header">
                <span class="step-label">Plan your ride</span>
                <h2 id="booking-title">Where are you going?</h2>
                <p>Start typing and select a location from the suggestions.</p>
            </div>

            <form id="rideForm" novalidate>
                <div class="location-field">
                    <label for="pickup">Pickup location</label>
                    <div class="location-input">
                        <span class="location-dot location-dot--pickup"></span>
                        <input id="pickup" type="text" placeholder="Enter pickup location" autocomplete="off"
                               aria-autocomplete="list" aria-controls="pickup-suggestions" required />
                    </div>
                    <div id="pickup-suggestions" class="location-suggestions" role="listbox" aria-live="polite"></div>
                </div>

                <div class="route-connector" aria-hidden="true"></div>

                <div class="location-field">
                    <label for="dropoff">Destination</label>
                    <div class="location-input">
                        <span class="location-dot location-dot--dropoff"></span>
                        <input id="dropoff" type="text" placeholder="Where to?" autocomplete="off"
                               aria-autocomplete="list" aria-controls="dropoff-suggestions" required />
                    </div>
                    <div id="dropoff-suggestions" class="location-suggestions" role="listbox" aria-live="polite"></div>
                </div>

                <fieldset class="payment-options">
                    <legend>Payment method</legend>
                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="Wallet" checked />
                        <span class="payment-option__icon"><i class="fa-solid fa-wallet"></i></span>
                        <span><strong>Wallet</strong><small>Pay from your balance</small></span>
                    </label>
                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="Cash" />
                        <span class="payment-option__icon"><i class="fa-solid fa-money-bill-wave"></i></span>
                        <span><strong>Cash</strong><small>Pay after the ride</small></span>
                    </label>
                </fieldset>

                <div id="walletBalance" class="wallet-balance" hidden>
                    Available balance <strong>EGP <span id="balanceAmount">0.00</span></strong>
                </div>

                <p id="locationMessage" class="booking-message" role="status" hidden></p>
                <button type="submit" class="booking-submit">
                    <span>See trip estimate</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <section id="quote" class="trip-quote" aria-live="polite" hidden>
                <div class="trip-quote__header">
                    <div><span class="step-label">Your estimate</span><h3>Trip summary</h3></div>
                    <div class="trip-price"><small>Estimated</small>EGP <span id="priceText">—</span></div>
                </div>
                <div class="trip-metrics">
                    <div><i class="fa-solid fa-road"></i><span><small>Distance</small><strong><span id="distanceText">—</span> km</strong></span></div>
                    <div><i class="fa-regular fa-clock"></i><span><small>Travel time</small><strong><span id="durationText">—</span> min</strong></span></div>
                    <div><i class="fa-solid fa-credit-card"></i><span><small>Payment</small><strong id="selectedPaymentMethod">Wallet</strong></span></div>
                </div>
                <p id="paymentInfo" class="payment-info">Payment will be deducted from your wallet after the ride is completed.</p>
                <button id="requestNowBtn" type="button" class="request-ride" disabled>Request Uber</button>
                <div id="requestStatus" class="request-status" hidden>
                    <span class="spinner" aria-hidden="true"></span><span id="statusText">Processing your request…</span>
                </div>
            </section>
        </section>

        <section class="map-card" aria-label="Ride map">
            <div class="map-card__header">
                <div><span class="live-indicator"></span><strong>Live trip map</strong></div>
                <span>Powered by OpenStreetMap</span>
            </div>
            <div id="map"></div>
            <div id="mapHint" class="map-hint" role="status">
                <i class="fa-solid fa-circle-info"></i>
                <span>Select both locations to display your route.</span>
            </div>
        </section>
    </div>
</section>

<section class="service-strip" aria-label="Uber service highlights">
    <div><i class="fa-solid fa-bolt"></i><span><strong>Fast matching</strong><small>Find nearby available drivers</small></span></div>
    <div><i class="fa-solid fa-map-location-dot"></i><span><strong>Live progress</strong><small>Follow every stage of your ride</small></span></div>
    <div><i class="fa-solid fa-lock"></i><span><strong>Secure account</strong><small>Your ride information stays protected</small></span></div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
}
