@model Uber.Ui.Models.CreateDriverModel
@{
    ViewData["Title"] = "Create driver account";
}

@section Styles {
    <link rel="stylesheet" href="~/css/registration.css" asp-append-version="true" />
}

<div class="auth-page auth-page--register auth-page--driver">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Drive with Uber</span>
        <h1>Turn your time on the road into opportunity.</h1>
        <p>Tell us about yourself and your vehicle. We use these details to create a safer experience for every trip.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card auth-card--wide registration-card">
            <header class="auth-card__header">
                <h2>Create driver account</h2>
                <p>Complete your personal and vehicle information.</p>
            </header>
            <form action="/api/auth/register/driver" method="post" enctype="multipart/form-data" class="registration-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="form-grid">
                    <div class="registration-section-title form-field--full">
                        <span>Personal details</span>
                        <p>Tell us who you are and how riders can identify you.</p>
                    </div>
                    <div class="form-field form-field--full">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control-app" autocomplete="name" placeholder="Your full name" />
                    </div>
                    <div class="form-field">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control-app" autocomplete="email" placeholder="you@example.com" />
                    </div>
                    <div class="form-field">
                        <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="PhoneNumber" id="phone" class="form-control-app" type="tel" inputmode="numeric"
                               pattern="^0(10|11|12|15)\d{8}$" placeholder="01012345678" maxlength="11" />
                    </div>
                    <div class="form-field">
                        <label asp-for="DateOfBirth" class="form-label">Date of birth</label>
                        <input asp-for="DateOfBirth" class="form-control-app" type="date" min="1925-01-01" max="2007-12-31" />
                    </div>
                    <div class="form-field">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control-app" autocomplete="new-password" placeholder="At least 6 characters" />
                    </div>
                    <div class="form-field form-field--full">
                        <span class="form-label">Gender</span>
                        <div class="choice-grid">
                            <label class="choice-card"><input asp-for="Gender" type="radio" value="Male" /> <span>Male</span></label>
                            <label class="choice-card"><input asp-for="Gender" type="radio" value="Female" /> <span>Female</span></label>
                        </div>
                    </div>

                    <div class="registration-section-title form-field--full">
                        <span>Vehicle details</span>
                        <p>Add the information riders will see before pickup.</p>
                    </div>

                    <div class="form-field"><label asp-for="Vehicle.Brand" class="form-label">Vehicle brand</label><input asp-for="Vehicle.Brand" class="form-control-app" placeholder="Toyota" /></div>
                    <div class="form-field"><label asp-for="Vehicle.Model" class="form-label">Vehicle model</label><input asp-for="Vehicle.Model" class="form-control-app" placeholder="Corolla" /></div>
                    <div class="form-field"><label asp-for="Vehicle.YearMade" class="form-label">Production year</label><input asp-for="Vehicle.YearMade" class="form-control-app" type="number" min="2008" max="2027" /></div>
                    <div class="form-field"><label asp-for="Vehicle.Plate" class="form-label">License plate</label><input asp-for="Vehicle.Plate" class="form-control-app" placeholder="ABC 1234" /></div>
                    <div class="form-field"><label asp-for="Vehicle.Color" class="form-label"></label><input asp-for="Vehicle.Color" class="form-control-app" placeholder="Black" /></div>
                    <div class="form-field"><label asp-for="Vehicle.SeatingCapacity" class="form-label">Seats</label><input asp-for="Vehicle.SeatingCapacity" class="form-control-app" type="number" min="1" max="14" /></div>

                    <div class="form-field form-field--full">
                        <span class="form-label">Vehicle type</span>
                        <div class="choice-grid">
                            <label class="choice-card"><input asp-for="Vehicle.Type" type="radio" value="Car" /> <span>Car</span></label>
                            <label class="choice-card"><input asp-for="Vehicle.Type" type="radio" value="Scooter" /> <span>Scooter</span></label>
                            <label class="choice-card"><input asp-for="Vehicle.Type" type="radio" value="Shuttle" /> <span>Shuttle</span></label>
                        </div>
                    </div>
                    <div class="form-field">
                        <span class="form-label">Transmission</span>
                        <div class="choice-grid">
                            <label class="choice-card"><input asp-for="Vehicle.Transmission" type="radio" value="Manual" /> <span>Manual</span></label>
                            <label class="choice-card"><input asp-for="Vehicle.Transmission" type="radio" value="Automatic" /> <span>Automatic</span></label>
                        </div>
                    </div>
                    <div class="form-field">
                        <span class="form-label">Engine</span>
                        <div class="choice-grid">
                            <label class="choice-card"><input asp-for="Vehicle.VehicleEngine" type="radio" value="Gasoline" /> <span>Gas</span></label>
                            <label class="choice-card"><input asp-for="Vehicle.VehicleEngine" type="radio" value="Electric" /> <span>Electric</span></label>
                        </div>
                    </div>
                    <div class="form-field form-field--full">
                        <label asp-for="File" class="form-label">Profile photo <span class="form-hint">(optional)</span></label>
                        <input asp-for="File" class="form-control-app" type="file" accept="image/*" />
                    </div>
                </div>
                <button type="submit" class="btn-app btn-app--primary btn-app--block">Create driver account</button>
                <p class="auth-meta" style="justify-content:center; margin-bottom:0;">Already registered? <a asp-controller="Account" asp-action="Login" class="text-link">Log in</a></p>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const phoneInput = document.getElementById('phone');
        phoneInput?.addEventListener('input', () => phoneInput.value = phoneInput.value.replace(/\D/g, ''));
    </script>
}
