@model Uber.Application.Users.CustomerProfileResponse
@{
    ViewData["Title"] = "My account";
    var rideCount = Model.Rides.Count();
    var initial = string.IsNullOrWhiteSpace(Model.Customer.Name)
        ? "U"
        : Model.Customer.Name.Trim()[0].ToString().ToUpperInvariant();
}

@section Styles {
    <link rel="stylesheet" href="~/css/user-profile.css" asp-append-version="true" />
}

<section class="profile-page">
    <aside class="profile-navigation" aria-label="Account sections">
        <div class="profile-identity">
            <span class="profile-avatar" aria-hidden="true">@initial</span>
            <div>
                <span>Uber account</span>
                <h1>@Model.Customer.Name</h1>
                <p>@Model.Customer.Email</p>
            </div>
        </div>

        <nav class="profile-tabs" aria-label="Profile navigation">
            <button type="button" class="profile-tab active" data-profile-tab="rides" aria-controls="rides" aria-selected="true">
                <i class="fa-solid fa-clock-rotate-left"></i><span>Ride history</span>
            </button>
            <button type="button" class="profile-tab" data-profile-tab="wallet" aria-controls="wallet" aria-selected="false">
                <i class="fa-solid fa-wallet"></i><span>Wallet</span>
            </button>
            <button type="button" class="profile-tab" data-profile-tab="help" aria-controls="help" aria-selected="false">
                <i class="fa-regular fa-circle-question"></i><span>Help</span>
            </button>
            <button type="button" class="profile-tab" data-profile-tab="settings" aria-controls="settings" aria-selected="false">
                <i class="fa-solid fa-sliders"></i><span>Account settings</span>
            </button>
        </nav>

        <form asp-controller="Account" asp-action="Logout" method="post" class="profile-logout">
            <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i><span>Log out</span></button>
        </form>
    </aside>

    <div class="profile-content">
        <section id="rides" class="profile-section active" data-profile-panel>
            <header class="section-heading">
                <div>
                    <span class="section-kicker">Activity</span>
                    <h2>Your rides</h2>
                    <p>Review your latest Uber trips and their current status.</p>
                </div>
                <span class="ride-count">@rideCount @(rideCount == 1 ? "ride" : "rides")</span>
            </header>

            @if (Model.Rides.Any())
            {
                <div class="table-shell">
                    <table id="rideUserprofile" class="profile-table">
                        <thead>
                            <tr>
                                <th>Ride</th>
                                <th>Driver</th>
                                <th>Date</th>
                                <th>Trip</th>
                                <th>Price</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ride in Model.Rides)
                            {
                                var statusClass = ride.Status switch
                                {
                                    Uber.Domain.Enums.RideStatus.Completed => "status-success",
                                    Uber.Domain.Enums.RideStatus.Accepted => "status-success",
                                    Uber.Domain.Enums.RideStatus.InProgress => "status-progress",
                                    Uber.Domain.Enums.RideStatus.DriverWaiting => "status-progress",
                                    Uber.Domain.Enums.RideStatus.Rejected => "status-danger",
                                    Uber.Domain.Enums.RideStatus.Cancelled => "status-danger",
                                    _ => "status-pending"
                                };

                                <tr>
                                    <td><strong><a asp-controller="Ride" asp-action="RideDetails" asp-route-id="@ride.Id">#@ride.Id</a></strong></td>
                                    <td>
                                        <div class="driver-cell">
                                            @if (!string.IsNullOrEmpty(ride.DriverImagePath))
                                            {
                                                <img src="~/Files/@ride.DriverImagePath" alt="" />
                                            }
                                            else
                                            {
                                                <span aria-hidden="true"><i class="fa-solid fa-user"></i></span>
                                            }
                                            <strong>@(string.IsNullOrWhiteSpace(ride.DriverName) ? "Finding driver" : ride.DriverName)</strong>
                                        </div>
                                    </td>
                                    <td>@ride.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td>@ride.Distance km · @ride.Duration min</td>
                                    <td><strong>EGP @ride.Price?.ToString("F2")</strong></td>
                                    <td><span class="ride-status @statusClass">@ride.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-rides">
                    <span><i class="fa-solid fa-car-side"></i></span>
                    <h3>Your first ride starts here</h3>
                    <p>Choose a pickup and destination to get an instant trip estimate.</p>
                    <a asp-controller="Home" asp-action="Index">Plan a ride <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            }
        </section>

        <section id="wallet" class="profile-section" data-profile-panel hidden>
            <header class="section-heading">
                <div>
                    <span class="section-kicker">Payments</span>
                    <h2>Uber Wallet</h2>
                    <p>Keep your balance ready for quick, cash-free rides.</p>
                </div>
            </header>

            <div class="wallet-overview">
                <div>
                    <span>Available balance</span>
                    <strong><small>EGP</small> @Model.Customer.Balance.ToString("F2")</strong>
                    <p>Your wallet is protected and only charged after a ride is confirmed.</p>
                </div>
                <i class="fa-solid fa-wallet" aria-hidden="true"></i>
            </div>
            <a asp-controller="Payment" asp-action="Index" class="primary-action">Add funds</a>
        </section>

        <section id="help" class="profile-section" data-profile-panel hidden>
            <header class="section-heading">
                <div>
                    <span class="section-kicker">Support</span>
                    <h2>How can we help?</h2>
                    <p>Quick answers for the most common ride questions.</p>
                </div>
            </header>

            <div class="help-grid">
                <article><i class="fa-solid fa-location-dot"></i><h3>Requesting a ride</h3><p>Open the home page, select both locations, review the estimate, then request your Uber.</p></article>
                <article><i class="fa-solid fa-money-bill-wave"></i><h3>Payment options</h3><p>Choose Wallet for a cash-free trip or Cash when you want to pay the driver directly.</p></article>
                <article><i class="fa-solid fa-shield-halved"></i><h3>Ride safety</h3><p>Confirm the driver and vehicle details shown in the app before entering the vehicle.</p></article>
                <article><i class="fa-solid fa-headset"></i><h3>Need more help?</h3><p>Keep your ride number available when contacting the Uber support team.</p></article>
            </div>
        </section>

        <section id="settings" class="profile-section" data-profile-panel hidden>
            <header class="section-heading">
                <div>
                    <span class="section-kicker">Personal details</span>
                    <h2>Account settings</h2>
                    <p>Keep your contact information accurate for smoother rides.</p>
                </div>
            </header>

            <form id="userProfileForm" class="profile-form">
                <div class="profile-form-grid">
                    <label>
                        <span>Full name</span>
                        <input name="Name" value="@Model.Customer.Name" type="text" autocomplete="name" required />
                    </label>
                    <label>
                        <span>Email address</span>
                        <input name="Email" value="@Model.Customer.Email" type="email" autocomplete="email" readonly />
                    </label>
                    <label>
                        <span>Phone number</span>
                        <input name="PhoneNumber" value="@Model.Customer.PhoneNumber" id="phone" type="tel"
                               inputmode="numeric" pattern="^0(10|11|12|15)\d{8}$" placeholder="01012345678"
                               maxlength="11" autocomplete="tel" required />
                    </label>
                    <label>
                        <span>Date of birth</span>
                        <input name="DateOfBirth" value="@Model.Customer.DateOfBirth.ToString("yyyy-MM-dd")" type="date"
                               min="1925-01-01" max="2007-12-31" required />
                    </label>
                </div>
                <p id="profileFormStatus" class="form-status" role="status" hidden></p>
                <button type="submit" class="primary-action">Save changes</button>
            </form>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/user-profile.js" asp-append-version="true"></script>
}
