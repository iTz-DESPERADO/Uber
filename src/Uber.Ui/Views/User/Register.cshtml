@model Uber.Ui.Models.CreateUserModel
@{
    ViewData["Title"] = "Create rider account";
}

@section Styles {
    <link rel="stylesheet" href="~/css/registration.css" asp-append-version="true" />
}

<div class="auth-page auth-page--register auth-page--rider">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Ride with Uber</span>
        <h1>A better ride is only a few details away.</h1>
        <p>Create your rider account to request trips, follow progress in real time, and keep payments in one place.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card auth-card--wide registration-card">
            <header class="auth-card__header">
                <h2>Create rider account</h2>
                <p>Use accurate details so your driver can reach you when needed.</p>
            </header>
            <form action="/api/auth/register/user" method="post" class="registration-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="form-grid">
                    <div class="registration-section-title form-field--full">
                        <span>Personal details</span>
                        <p>Information your driver will use to identify and contact you.</p>
                    </div>
                    <div class="form-field form-field--full">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control-app" autocomplete="name" placeholder="Your full name" />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control-app" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                        <input asp-for="PhoneNumber" id="phone" class="form-control-app" type="tel" inputmode="numeric"
                               pattern="^0(10|11|12|15)\d{8}$" placeholder="01012345678" maxlength="11" />
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="DateOfBirth" class="form-label">Date of birth</label>
                        <input asp-for="DateOfBirth" class="form-control-app" type="date" min="1925-01-01" max="2007-12-31" />
                    </div>
                    <div class="form-field">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control-app" autocomplete="new-password" placeholder="At least 6 characters" />
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div class="form-field form-field--full">
                        <span class="form-label">Gender</span>
                        <div class="choice-grid">
                            <label class="choice-card"><input asp-for="Gender" type="radio" value="Male" /> <span>Male</span></label>
                            <label class="choice-card"><input asp-for="Gender" type="radio" value="Female" /> <span>Female</span></label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn-app btn-app--primary btn-app--block">Create rider account</button>
                <p class="auth-meta" style="justify-content:center; margin-bottom:0;">Already registered? <a asp-controller="Account" asp-action="Login" class="text-link">Log in</a></p>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const phoneInput = document.getElementById('phone');
        phoneInput?.addEventListener('input', () => phoneInput.value = phoneInput.value.replace(/\D/g, ''));
    </script>
}
