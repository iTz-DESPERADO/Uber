@{
    ViewData["Title"] = "Admin dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<section class="admin-dashboard">
    <header class="admin-dashboard__heading">
        <div>
            <span class="admin-dashboard__eyebrow">Uber administration</span>
            <h1>Operations overview</h1>
            <p>Manage people, trips, and platform access from one place.</p>
        </div>
        <span class="admin-dashboard__status"><i class="fa-solid fa-circle"></i> System online</span>
    </header>

    <div class="admin-action-grid" aria-label="Administration sections">
        <a asp-controller="Admin" asp-action="Admin_Drivers" class="admin-action-card">
            <span class="admin-action-card__icon"><i class="fa-solid fa-car-side"></i></span>
            <span class="admin-action-card__content">
                <strong>Drivers</strong>
                <small>Review driver accounts, vehicles, and availability.</small>
            </span>
            <span class="admin-action-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a asp-controller="Admin" asp-action="Admin_Riders" class="admin-action-card">
            <span class="admin-action-card__icon"><i class="fa-solid fa-users"></i></span>
            <span class="admin-action-card__content">
                <strong>Riders</strong>
                <small>View rider profiles and account information.</small>
            </span>
            <span class="admin-action-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a asp-controller="Admin" asp-action="Admin_Rides" class="admin-action-card">
            <span class="admin-action-card__icon"><i class="fa-solid fa-route"></i></span>
            <span class="admin-action-card__content">
                <strong>Rides</strong>
                <small>Track ride requests, progress, and trip history.</small>
            </span>
            <span class="admin-action-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>

        <a asp-controller="Admin" asp-action="Admin_Admins" class="admin-action-card">
            <span class="admin-action-card__icon"><i class="fa-solid fa-user-shield"></i></span>
            <span class="admin-action-card__content">
                <strong>Administrators</strong>
                <small>Manage the team members who can access this panel.</small>
            </span>
            <span class="admin-action-card__arrow"><i class="fa-solid fa-arrow-right"></i></span>
        </a>
    </div>

    <aside class="admin-dashboard__note">
        <i class="fa-solid fa-shield-halved"></i>
        <div><strong>Protected admin area</strong><span>All management actions require an Administrator account.</span></div>
    </aside>
</section>
