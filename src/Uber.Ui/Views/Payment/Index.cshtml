@{
    ViewData["Title"] = "Add wallet balance";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Uber Wallet</span>
        <h1>Keep every ride one tap away.</h1>
        <p>Add balance securely through Stripe. Your updated wallet will be ready for upcoming trips.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <span class="role-icon"><i class="fa-solid fa-wallet"></i></span>
            <header class="auth-card__header" style="margin-top:1.25rem;">
                <h2>Add wallet balance</h2>
                <p>Enter the amount you want to add. You’ll continue to secure checkout.</p>
            </header>
            <form id="checkoutForm">
                <div class="form-field">
                    <label for="amount" class="form-label">Amount (EGP)</label>
                    <input id="amount" class="form-control-app" type="number" name="amount" min="1" step="0.01" value="50.00" required />
                    <span class="form-hint">Minimum top-up: EGP 1.00</span>
                </div>
                <button type="submit" class="btn-app btn-app--primary btn-app--block"
                        disabled="@(ViewBag.StripeConfigured == true ? null : "disabled")">
                    <i class="fa-solid fa-lock"></i> Continue to checkout
                </button>
            </form>
            @if (ViewBag.StripeConfigured != true)
            {
                <p class="oauth-note"><i class="fa-solid fa-circle-info"></i> Stripe sandbox needs an <code>sk_test_</code> key in User Secrets.</p>
            }
            <p class="auth-meta" style="justify-content:center; margin-bottom:0;"><i class="fa-brands fa-stripe"></i> Payments are processed securely by Stripe.</p>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById('checkoutForm').addEventListener('submit', async event => {
            event.preventDefault();
            const button = event.currentTarget.querySelector('button');
            button.disabled = true;
            button.textContent = 'Preparing checkout…';

            const amount = Number(event.currentTarget.elements.amount.value);
            const response = await fetch('/api/payments/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount })
            });
            const payload = await response.json();

            if (!response.ok) {
                button.disabled = false;
                button.textContent = 'Continue to checkout';
                alert(payload.detail || payload.message || 'Unable to start checkout');
                return;
            }

            window.location.href = payload.checkoutUrl;
        });
    </script>
}
