@model Uber.Ui.Models.ResetPasswordModel
@{
    ViewData["Title"] = "Choose new password";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Secure your account</span>
        <h1>Choose a password that’s hard to guess.</h1>
        <p>Use at least six characters and avoid passwords you use on other services.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <header class="auth-card__header">
                <h2>Create a new password</h2>
                <p>You’ll use it the next time you sign in.</p>
            </header>
            <form method="post">
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <div class="form-field">
                    <label asp-for="Password" class="form-label">New password</label>
                    <input asp-for="Password" class="form-control-app" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="form-field">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control-app" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <button type="submit" class="btn-app btn-app--primary btn-app--block">Update password</button>
            </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
