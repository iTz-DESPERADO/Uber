@{
    ViewData["Title"] = "Create account";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Start your journey</span>
        <h1>Ride your way. Drive on your terms.</h1>
        <p>Choose the account that fits you today. You can always contact support if your needs change.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <header class="auth-card__header">
                <h2>How will you use Uber?</h2>
                <p>Select an option to create the right account.</p>
            </header>
            <div class="role-options">
                <a asp-controller="Account" asp-action="Register" asp-route-role="User" class="role-card">
                    <span class="role-icon"><i class="fa-solid fa-location-dot"></i></span>
                    <div><h3>Ride with us</h3><p>Book rides, track your driver, and manage payments.</p></div>
                </a>
                <a asp-controller="Account" asp-action="Register" asp-route-role="Driver" class="role-card">
                    <span class="role-icon"><i class="fa-solid fa-car"></i></span>
                    <div><h3>Drive with us</h3><p>Receive trip requests and grow your earnings.</p></div>
                </a>
            </div>
            <p class="auth-meta" style="justify-content:center; margin-bottom:0;">Already registered? <a asp-action="Login" class="text-link">Log in</a></p>
        </div>
    </section>
</div>
