@model Uber.Ui.Models.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Account recovery</span>
        <h1>We’ll help you get moving again.</h1>
        <p>Enter the email linked to your account and we’ll send you a secure reset link.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <header class="auth-card__header">
                <h2>Reset your password</h2>
                <p>The link will expire for your security.</p>
            </header>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control-app" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email"></span>
                </div>
                <button type="submit" class="btn-app btn-app--primary btn-app--block">Send reset link</button>
                <p class="auth-meta" style="justify-content:center; margin-bottom:0;"><a asp-action="Login" class="text-link">Back to login</a></p>
            </form>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
