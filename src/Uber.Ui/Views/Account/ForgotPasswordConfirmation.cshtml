@{
    ViewData["Title"] = "Check your email";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Almost there</span>
        <h1>Check your inbox.</h1>
        <p>If an account matches that email, a password reset link is on its way.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <span class="role-icon"><i class="fa-regular fa-envelope"></i></span>
            <header class="auth-card__header" style="margin-top:1.25rem;">
                <h2>Email sent</h2>
                <p>For privacy, we show the same confirmation whether or not an account exists.</p>
            </header>
            <a asp-action="Login" class="btn-app btn-app--primary btn-app--block">Return to login</a>
        </div>
    </section>
</div>
