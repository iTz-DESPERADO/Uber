@{
    ViewData["Title"] = "Password updated";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Account secured</span>
        <h1>You’re ready to move again.</h1>
        <p>Your password has been updated. Sign in with your new credentials to continue.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <span class="role-icon"><i class="fa-solid fa-check"></i></span>
            <header class="auth-card__header" style="margin-top:1.25rem;">
                <h2>Password updated</h2>
                <p>Your account is ready.</p>
            </header>
            <a asp-action="Login" class="btn-app btn-app--primary btn-app--block">Log in</a>
        </div>
    </section>
</div>
