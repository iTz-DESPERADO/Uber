@model Uber.Ui.Models.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">Move with confidence</span>
        <h1>Your city is closer than you think.</h1>
        <p>Sign in to request a ride, manage your wallet, or get back on the road as a driver.</p>
    </section>

    <section class="auth-panel">
        <div class="auth-card">
            <header class="auth-card__header">
                <h2>Welcome back</h2>
                <p>Enter your details to continue to your account.</p>
            </header>

            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control-app" autocomplete="email" placeholder="you@example.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control-app" autocomplete="current-password" placeholder="Enter your password" />
                    <span asp-validation-for="Password"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(ViewBag.LoginError))
                {
                    <p class="field-validation-error">@ViewBag.LoginError</p>
                }

                <div class="auth-meta">
                    <label class="choice-card">
                        <input asp-for="RememberMe" />
                        <span>Keep me signed in</span>
                    </label>
                    <a asp-action="ForgotPassword" class="text-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-app btn-app--primary btn-app--block">Log in</button>
            </form>

            <div class="auth-divider">or continue with</div>
            @if (Model.ExternalLogins.Count > 0)
            {
                <form method="post" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="social-stack">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit" class="btn-app btn-app--outline btn-app--block"
                                name="provider" value="@provider.Name">
                            <i class="@(provider.Name == "Facebook" ? "fa-brands fa-facebook" : "fa-brands fa-google")"></i>
                            @provider.DisplayName
                        </button>
                    }
                </form>
            }
            else
            {
                <div class="social-stack" aria-label="External login providers">
                    <button type="button" class="btn-app btn-app--outline btn-app--block oauth-disabled" disabled>
                        <i class="fa-brands fa-google"></i> Continue with Google
                        <span>Setup required</span>
                    </button>
                    <button type="button" class="btn-app btn-app--outline btn-app--block oauth-disabled" disabled>
                        <i class="fa-brands fa-facebook"></i> Continue with Facebook
                        <span>Setup required</span>
                    </button>
                    <p class="oauth-note"><i class="fa-solid fa-circle-info"></i> Social login becomes active after its Client ID and secret are configured.</p>
                </div>
            }

            <p class="auth-meta" style="justify-content:center; margin-bottom:0;">
                New to Uber?
                <a asp-action="ChooseRegisterType" class="text-link">Create an account</a>
            </p>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
