@{
    ViewData["Title"] = "Choose account";
}

<div class="auth-page">
    <section class="auth-aside">
        <span class="auth-aside__eyebrow">One platform</span>
        <h1>Where are you headed today?</h1>
        <p>Riders and drivers use one secure sign-in. We’ll take you to the right experience automatically.</p>
    </section>
    <section class="auth-panel">
        <div class="auth-card">
            <header class="auth-card__header">
                <h2>Continue to Uber</h2>
                <p>Use your email or a connected account to sign in.</p>
            </header>
            <a asp-controller="Account" asp-action="Login" class="btn-app btn-app--primary btn-app--block">Continue to login</a>
        </div>
    </section>
</div>
