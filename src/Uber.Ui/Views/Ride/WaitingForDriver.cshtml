@model string 

@{
    ViewData["Title"] = "Finding your driver";
}
<section class="waiting-card">
    <div class="waiting-pulse"><i class="fa-solid fa-car-side"></i></div>
    <span class="auth-aside__eyebrow" style="color:var(--color-primary);">Ride @Model</span>
    <h1>Finding the best driver nearby</h1>
    <p>We’re sharing your request with available drivers. This usually takes less than a minute.</p>
    <div id="status" class="waiting-status">Looking for drivers…</div>
    <div id="connectionStatus" class="connection-pill">
        <span class="connection-dot"></span>
        <strong>Live updates:</strong> <span id="statusText">Connecting…</span>
    </div>
</section>

<style>
    .waiting-card { width:min(680px,calc(100% - 2rem)); margin:clamp(2rem,8vw,7rem) auto; padding:clamp(1.5rem,5vw,3rem); text-align:center; background:#fff; border:1px solid var(--color-border); border-radius:var(--radius-lg); box-shadow:var(--shadow-md); }
    .waiting-card h1 { margin:.8rem 0; font-size:clamp(2rem,5vw,3.25rem); letter-spacing:-.045em; }
    .waiting-card > p { max-width:520px; margin:0 auto 1.5rem; color:var(--color-muted); line-height:1.7; }
    .waiting-pulse { width:76px; height:76px; display:grid; place-items:center; margin:0 auto 1.5rem; border-radius:1.4rem; color:#fff; background:var(--color-primary); font-size:1.75rem; animation:waitingPulse 1.8s infinite; }
    .waiting-status { padding:1rem; border-radius:.9rem; background:var(--color-primary-soft); color:var(--color-primary-dark); font-weight:700; }
    .connection-pill { display:inline-flex; align-items:center; gap:.5rem; margin-top:1rem; padding:.55rem .8rem; border:1px solid var(--color-border); border-radius:999px; color:var(--color-muted); font-size:.8rem; }
    .connection-dot { width:8px; height:8px; border-radius:50%; background:#22c55e; }
    @@keyframes waitingPulse { 50% { transform:translateY(-5px); box-shadow:0 14px 30px rgba(15,118,110,.25); } }
</style>
<script>
    let connection = null;
    let isConnected = false;
    const currentRideId = Number('@Model');

    async function refreshRideState() {
        if (!Number.isInteger(currentRideId) || currentRideId <= 0) {
            window.location.href = '/Home';
            return;
        }

        const response = await fetch(`/api/rides/${currentRideId}`, {
            credentials: 'same-origin'
        });

        if (!response.ok) {
            document.getElementById('status').textContent =
                'We could not restore this ride. Return home and try again.';
            return;
        }

        const ride = await response.json();

        if (['Accepted', 'DriverWaiting', 'InProgress', 'Completed', 'Cancelled'].includes(ride.status)) {
            window.location.href = `/Ride/RideDetails/${currentRideId}`;
            return;
        }

        if (ride.status === 'Rejected') {
            document.getElementById('status').innerHTML = `
                <div style="color:#b45309; padding:20px; text-align:center;">
                    <h3>No driver is available right now</h3>
                    <p>Please return home and request another ride.</p>
                    <a class="btn-app btn-app--primary" href="/Home">Back to Home</a>
                </div>`;
            return;
        }

        document.getElementById('status').textContent = 'Looking for drivers…';
    }

    async function initializeConnection() {
        try {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/rideHub", { 
                    skipNegotiation: true,
                    transport: signalR.HttpTransportType.WebSockets
                })
                .withAutomaticReconnect()
        .build();

            setupEventListeners();

            connection.onreconnecting(() => {
                updateStatus("Reconnecting...", "orange");
            });

            connection.onreconnected(async () => {
                updateStatus("Connected", "green");
                isConnected = true;
                await connection.invoke("JoinRideGroup", currentRideId);
                await refreshRideState();
            });

            connection.onclose(() => {
                updateStatus("Disconnected", "red");
                isConnected = false;
            });

            await connection.start();
            
            updateStatus("Connected", "green");
            isConnected = true;

            // Join the ride group when page loads
            await connection.invoke("JoinRideGroup", currentRideId);
            await refreshRideState();

        } catch (err) {
            console.error("SignalR Connection Error:", err);
            updateStatus("Connection Failed: " + err.message, "red");
            
            document.getElementById("status").innerHTML = `
                <div style="color: red; padding: 20px; text-align: center;">
                    <h3>⚠️ Connection Error</h3>
                    <p>Failed to connect to real-time updates: ${err.message}</p>
                    <button onclick="location.reload()" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer;">
                        🔄 Retry Connection
                    </button>
                </div>
            `;
        }
    }

    // Set up event listeners after connection is created
    function setupEventListeners() {
        if (!connection) {
            return;
        }

        // Listen for ride accepted event
        connection.on("RideAccepted", function (rideId) {
            if (rideId == @Model) {
                document.getElementById("status").innerHTML = `
                    <div style="color: green; padding: 20px; text-align: center;">
                        <h3>🚗 Driver accepted your request!</h3>
                        <p>Your driver is on the way!</p>
                        <p>Redirecting to ride details in 3 seconds...</p>
                    </div>
                `;
                window.setTimeout(refreshRideState, 250);
                
                // Redirect to ride details page after a short delay
                setTimeout(() => {
                    window.location.href = `/Ride/RideDetails/${rideId}`;
                }, 3000);
            }
        });

        // Listen for ride rejected event
        connection.on("RideRejected", function (rideId) {
            if (rideId == @Model) {
                document.getElementById("status").innerHTML = `
                    <div style="color: orange; padding: 20px; text-align: center;">
                        <h3>⚠️ Driver rejected your request</h3>
                        <p>Looking for another driver...</p>
                    </div>
                `;
            }
        });

    }

    function updateStatus(message, color) {
        const statusText = document.getElementById("statusText");
        statusText.textContent = message;
        statusText.style.color = color;
    }

    // Initialize connection when page loads
    document.addEventListener('DOMContentLoaded', function() {

        initializeConnection();
        refreshRideState();
	});

</script>


